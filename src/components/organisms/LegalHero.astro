---
// src/components/molecules/LegalHero.astro
interface Props {
  title: string;
  description?: string;
  updatedAt?: string | Date;
}

const { title, description, updatedAt } = Astro.props;

// Formatage de la date en français (ex: 19 septembre 2026)
const formattedDate = updatedAt
  ? new Intl.DateTimeFormat("fr-FR", {
      day: "numeric",
      month: "long",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit"
    }).format(new Date(updatedAt))
  : null;

const isoDate = updatedAt ? new Date(updatedAt).toISOString() : undefined;
---

<header class="legal-hero">
  {
    formattedDate && (
      <div class="legal-hero__meta eyebrow">
        <span>// LAST_REVISION:</span>
        <time datetime={isoDate}>
          {formattedDate}
        </time>
      </div>
    )
  }

  <h1 class="legal-hero__title">{title}</h1>

  {description && <p class="legal-hero__description">{description}</p>}
</header>

<style>
  .legal-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--border-light);
  }

  .legal-hero__meta {
    width: fit-content;
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-copper);
  }
</style>
