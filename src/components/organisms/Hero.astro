---
import type { Button } from "@@types/button";
import PrimaryButton from "@components/atoms/Buttons/PrimaryButton.astro";
import SecondaryButton from "@components/atoms/Buttons/SecondaryButton.astro";

interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  summary: string;
  primaryButton: Button
  secondaryButton?: Button
}

const { id, title, subtitle, summary, primaryButton,  secondaryButton} = Astro.props;


---

<section id={id} class="hero">
  <div class="hero-body">
    <h1 class="hero-title">
      {title}{subtitle && <br />
      <em>{subtitle}</em>}
    </h1>
    <p class="hero-bio">
      {summary}
    </p>
  </div>

  <div class="hero-footer-row">
    <div class="hero-actions">
      <PrimaryButton
        label={primaryButton.label}
        href={primaryButton.href}
        ariaLabel={primaryButton.ariaLabel}
      />
      {secondaryButton && <SecondaryButton
        label={secondaryButton.label}
        href={secondaryButton.href}
        ariaLabel={secondaryButton.ariaLabel}
      />}

    </div>
  </div>
</section>

<style>
  .hero {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    position: relative;
    padding: var(--space-4xl) 0px;
  }
  .hero-body {
    max-width: 920px;
  }
  .hero-title {
    font-family: var(--font-serif);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: var(--tracking-tighter);
    margin-bottom: var(--space-l);
  }
  .hero-title em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-copper);
  }
  .hero-bio {
    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
    max-width: 820px;
    text-align: justify;
  }
  .hero-footer-row {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding-top: var(--space-s);
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    flex-wrap: wrap;
  }
</style>
