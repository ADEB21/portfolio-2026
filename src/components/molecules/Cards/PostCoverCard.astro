---
import type { Post } from "@@types/post";
import { urlFor } from "@assets/script/utils/image";

interface Props {
  post: Post;
}

const { post } = Astro.props;

const coverUrl = post.coverImage
  ? urlFor(post.coverImage).width(1200).height(675).auto("format").url()
  : null;
---

<div class="article-cover-wrapper">
  <div class="cover-frame">
    <div class="cover-header">
      <div class="dots">
        <span class="red"></span>
        <span class="orange"></span>
        <span class="green"></span>
      </div>
      <span class="cover-format">16:9</span>
    </div>
    <div transition:name={`cover-${post.slug}`} class="cover-image-container">
      <img
        src={coverUrl}
        alt={post.coverImage?.alt || post.title}
        class="cover-img"
        loading="eager"
      />
    </div>
  </div>
</div>

<style>
  .article-cover-wrapper {
    margin: var(--space-2xl, 2.5rem) 0 var(--space-3xl, 3.5rem) 0;
    position: relative;
  }

  .cover-frame {
    background: var(--color-white);
    border: 1px solid var(--color-brown);
    border-radius: 12px;
    overflow: hidden;
    /* Ombre portée franche et chaude (aucun flou terne) */
    box-shadow: 6px 6px 0px var(--color-brown);
  }

  .cover-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1rem;
    background: var(--color-brown);
    color: var(--color-white);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
  }

  .cover-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1rem;
    background: var(--color-brown);
    color: var(--color-white);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
  }

  .dots {
    display: flex;
    gap: var(--space-2xs);
  }

  .red,
  .green,
  .orange {
    display: block;
    width: 12px;
    height: 12px;
    background-color: #fe5f56;
    border-radius: 8px;
  }

  .orange {
    background-color: #febb30;
  }

  .green {
    background-color: #2bc840;
  }

  .cover-tag {
    color: var(--color-white);
  }

  .cover-image-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #140c09;
    overflow: hidden;
  }

  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .cover-frame:hover .cover-img {
    transform: scale(1.015);
  }
</style>
