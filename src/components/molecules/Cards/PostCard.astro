---
// src/components/PostCard.astro
import { Image } from "astro:assets";
import { urlFor } from "@assets/script/utils/image";
import type { Post } from "@@types/index";
import CircleButton from "@components/atoms/Buttons/CircleButton.astro";
import SkillIcon from "../SkillIcon.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;

const coverImageUrl = post.coverImage?.asset
  ? urlFor(post.coverImage.asset).width(700).auto("format").url()
  : null;

const categories = post.categories.map((c) => c.title).join(" • ");
const date =
  post._type === "project" ? post.publishedAt.split("-")[0] : post.publishedAt;
---

<article
  class={`card ${post.isFeatured ? "featured" : ""}`}
  data-categories={JSON.stringify(
    post.categories.map((cat) => cat.title) || [],
  )}
>
  <div class="card-content">
    <header class="post-header">
      <div class="header-left"><p>{categories}</p></div>
      <div class="header-right">
        <p>{date}{post.readTime && ` • ${post.readTime} mins`}</p>
      </div>
    </header>

    <body class="post-body">
      <h3 class="post-title">{post.title}</h3>
      <p class="post-summary">{post.summary}</p>
    </body>

    <div class="post-footer">
      {
        post?.stack && (
          <ul class="footer-left">
            {post.stack.map((tech) => (
              <li>
                <SkillIcon skill={tech} />
              </li>
            ))}
          </ul>
        )
      }
      {
        post._type === "post" && post?.categories && (
          <ul class="footer-left">
            {post.categories.map((tech) => (
              <li>
                <SkillIcon skill={tech} />
              </li>
            ))}
          </ul>
        )
      }
      <div class="footer-right">
        <CircleButton
          href={post._type === "project"
            ? `/projects/${post.slug}`
            : `/blog/${post.slug}`}
          isBlank={false}
          ariaLabel={`Lire l'article : ${post.title}`}
        />
      </div>
    </div>
  </div>

  {
    post.isFeatured && coverImageUrl && (
      <div class="card-cover">
        <Image
          transition:name={`cover-${post.slug}`}
          src={coverImageUrl}
          width={700}
          height={400}
          alt={post.coverImage?.alt || post.title}
        />
      </div>
    )
  }
</article>

<style>
  p {
    margin: 0;
  }
  .card {
    display: grid;
    height: auto;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-l);
    align-items: stretch;
  }

  .card:hover .card-cover img {
    transform: scale(1.03);
  }
  .card:hover .post-title {
    color: #b85b35;
  }

  .card.featured {
    grid-column: span 2;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: var(--space-l);
  }

  .card:not(.featured) .card-content {
    grid-column: span 2;
  }

  .post-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .header-left,
  .header-right {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: #8c7a70;
  }
  .header-right {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .category-names {
    color: #6b5b54;
    font-weight: 600;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .post-title {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.65rem;
    font-weight: 600;
    line-height: 1.25;
    margin: 0;
    transition: color 0.4s ease;
  }

  .post-summary {
    display: block;
    color: #5a4a42;
    font-size: var(--text-sm);
    margin: 0;

    text-overflow: ellipsis;
    word-wrap: break-word;
    overflow: hidden;
    max-height: 6.4em;
    line-height: 1.6;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(76, 43, 36, 0.1);
    padding-top: 1rem;
    gap: 1rem;
  }

  .footer-left {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    list-style: none;
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    background: #ffffff;
    border: 1px solid rgba(76, 43, 36, 0.14);
    padding: 3px 9px;
    border-radius: 9999px;
    color: var(--color-brown);
  }

  .post-year-badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: #b85b35;
    background: rgba(184, 91, 53, 0.1);
    padding: 3px 9px;
    border-radius: 6px;
  }

  @media (max-width: 768px) {
    .card.featured {
      grid-column: span 1;
      grid-template-columns: 1fr;
    }
  }
</style>

<script define:vars={{ post }}>
  console.log(post);
</script>
