---
// src/components/PostCard.astro
import { Image } from "astro:assets";
import { urlFor } from "@assets/script/utils/image";
import type { Post } from "@@types/index";

interface Props {
  post: Post;
}

const { post } = Astro.props;

const coverImageUrl = post.coverImage?.asset
  ? urlFor(post.coverImage.asset).width(700).auto("format").url()
  : null;
---

<article
  class={`bento-card card ${post.isFeatured ? "featured" : ""}`}
  data-categories={JSON.stringify(
    post.categories.map((cat) => cat.title) || [],
  )}
>
  <div class="card-content">
    <div class="post-top-meta">
      <div class="category-meta-group">
        <span class="category-names">
          {post.categories?.map((c) => c.title).join(" · ") || "Article"}
        </span>
      </div>
      <div class="post-read-meta">
        <span class="post-date">{post.publishedAt}</span>
        <span class="meta-separator">&bull;</span>
        <span class="post-read-time">{post.readTime || "5 min"}</span>
      </div>
    </div>

    <div class="post-body">
      <h3 class="post-title">
        <a href={`/blog/${post.slug}`}>{post.title}</a>
      </h3>
      <p class="post-excerpt">{post.excerpt}</p>
    </div>

    <div class="post-footer">
      <div class="tech-pills">
        {post.tags?.map((tag) => <span class="tag-pill">{tag}</span>)}
      </div>
      <a
        href={`/blog/${post.slug}`}
        class="btn-circle-action"
        aria-label={`Lire l'article : ${post.title}`}
      >
        &rarr;
      </a>
    </div>
  </div>

  {
    post.isFeatured && coverImageUrl && (
      <div class="post-cover-wrapper">
        <Image
          src={coverImageUrl}
          width={700}
          height={400}
          alt={post.coverImage?.alt || post.title}
          class="post-cover-img"
        />
      </div>
    )
  }
</article>

<style>
  .card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-l);
    align-items: stretch;
  }

  .card.featured {
    grid-column: span 2;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: 1.5rem;
  }

  .post-top-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .category-meta-group {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .category-names {
    color: #6b5b54;
    font-weight: 600;
  }

  .post-read-meta {
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    color: #8c7a70;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .post-title {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.65rem;
    font-weight: 600;
    line-height: 1.25;
    margin: 0;
  }

  .post-title a {
    color: #2b1810;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .post-title a:hover {
    color: #b85b35;
  }

  .post-excerpt {
    color: #5a4a42;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(76, 43, 36, 0.1);
    padding-top: 1rem;
    gap: 1rem;
  }

  .tech-pills {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag-pill {
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    background: #ffffff;
    border: 1px solid rgba(76, 43, 36, 0.14);
    padding: 3px 9px;
    border-radius: 9999px;
    color: #2b1810;
  }

  .btn-circle-action {
    width: 38px;
    height: 38px;
    min-width: 38px;
    border-radius: 50%;
    background: #2b1810;
    color: #fbf7ee;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 1.1rem;
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }

  .btn-circle-action:hover {
    background: #b85b35;
    transform: scale(1.08);
  }

  .post-cover-wrapper {
    width: 100%;
    height: 100%;
    min-height: 240px;
    border-radius: 16px;
    overflow: hidden;
  }

  .post-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .blog-card:hover .post-cover-img {
    transform: scale(1.03);
  }

  @media (max-width: 900px) {
    .blog-card.featured {
      grid-column: span 1;
      grid-template-columns: 1fr;
    }
  }
</style>
