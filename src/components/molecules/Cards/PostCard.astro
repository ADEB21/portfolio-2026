---
// src/components/PostCard.astro
import { Image } from 'astro:assets';
import { urlFor } from '@assets/script/utils/image';
import type { Post } from '@@types/index';

interface Props {
  post: Post;
}

const { post } = Astro.props;

const coverImageUrl = post.coverImage?.asset
  ? urlFor(post.coverImage.asset).width(700).auto('format').url()
  : null;
---

<article class={`bento-card blog-card ${post.isFeatured ? 'featured' : ''}`}>
  <div class="card-content">
    <div class="post-top-meta">
      <div class="category-meta-group">
        <span class="category-prefix">//</span>
        <span class="category-names">
          {post.categories?.map((c) => c.title).join(' · ') || 'Article'}
        </span>
      </div>
      <div class="post-read-meta">
        <span class="post-date">{post.publishedAt}</span>
        <span class="meta-separator">&bull;</span>
        <span class="post-read-time">{post.readTime || '5 min'}</span>
      </div>
    </div>

    <div class="post-body">
      <h3 class="post-title">
        <a href={`/blog/${post.slug}`}>{post.title}</a>
      </h3>
      <p class="post-excerpt">{post.excerpt}</p>
    </div>

    <div class="post-footer">
      <div class="tech-pills">
        {post.tags?.map((tag) => (
          <span class="tag-pill">{tag}</span>
        ))}
      </div>
      <a
        href={`/blog/${post.slug}`}
        class="btn-circle-action"
        aria-label={`Lire l'article : ${post.title}`}
      >
        &rarr;
      </a>
    </div>
  </div>

  {post.isFeatured && coverImageUrl && (
    <div class="post-cover-wrapper">
      <Image
        src={coverImageUrl}
        width={700}
        height={400}
        alt={post.coverImage?.alt || post.title}
        class="post-cover-img"
      />
    </div>
  )}
</article>

<style>
  .blog-card {
    background: #FBF7EE;
    border: 1px solid rgba(76, 43, 36, 0.16);
    border-radius: 24px;
    padding: var(--space-2xl, 2rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 360px;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    border-color: #B85B35;
    box-shadow: 0 16px 32px -8px rgba(76, 43, 36, 0.12);
  }

  .blog-card.featured {
    grid-column: span 2;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2rem;
    align-items: stretch;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: 1.5rem;
  }

  .post-top-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .category-meta-group {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .category-prefix {
    color: #B85B35;
    font-weight: 700;
  }

  .category-names {
    color: #6B5B54;
    font-weight: 600;
  }

  .post-read-meta {
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    color: #8C7A70;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .post-title {
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.65rem;
    font-weight: 600;
    line-height: 1.25;
    margin: 0;
  }

  .post-title a {
    color: #2B1810;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .post-title a:hover {
    color: #B85B35;
  }

  .post-excerpt {
    color: #5A4A42;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(76, 43, 36, 0.1);
    padding-top: 1rem;
    gap: 1rem;
  }

  .tech-pills {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag-pill {
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    background: #FFFFFF;
    border: 1px solid rgba(76, 43, 36, 0.14);
    padding: 3px 9px;
    border-radius: 9999px;
    color: #2B1810;
  }

  .btn-circle-action {
    width: 38px;
    height: 38px;
    min-width: 38px;
    border-radius: 50%;
    background: #2B1810;
    color: #FBF7EE;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 1.1rem;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .btn-circle-action:hover {
    background: #B85B35;
    transform: scale(1.08);
  }

  .post-cover-wrapper {
    width: 100%;
    height: 100%;
    min-height: 240px;
    border-radius: 16px;
    overflow: hidden;
  }

  .post-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .blog-card:hover .post-cover-img {
    transform: scale(1.03);
  }

  @media (max-width: 900px) {
    .blog-card.featured {
      grid-column: span 1;
      grid-template-columns: 1fr;
    }
  }
</style>