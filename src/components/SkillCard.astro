---
import TechIcon from "./TechIcon";

const { skill } = Astro.props;
---

<article class="bento-card skill-bento-card">
  <div class="skill-header">
    <span class="skill-tag">// {skill.tag}</span>
    <h3 class="skill-title">{skill.title}</h3>
    <p class="skill-desc">{skill.description}</p>
  </div>

  <div class="tech-icon-grid">
    {
      skill.technologies.map((tech) => (
        <div class="tech-pill-item" title={tech.name}>
          <TechIcon name={tech.slug} size={20} client:idle />
          <span class="tech-name">{tech.name}</span>
        </div>
      ))
    }
  </div>
</article>

<style>
  .skill-bento-card {
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-l);
  }

  .skill-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-copper);
    letter-spacing: var(--tracking-widest);
    display: block;
    margin-bottom: var(--space-3xs);
  }

  .skill-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--text-espresso);
    margin-bottom: var(--space-3xs);
  }

  .skill-desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-normal);
  }

  .tech-icon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: var(--space-xs);
    border-top: 1px solid var(--border-light);
    padding-top: var(--space-md);
  }

  .tech-pill-item {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    background: var(--bg-card-solid);
    border: 1px solid var(--border-light);
    padding: 8px 12px;
    border-radius: var(--radius-md);
    transition:
      transform var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  .tech-pill-item:hover {
    transform: translateY(-2px);
    border-color: var(--border-hover);
  }

  .tech-name {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-espresso);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
