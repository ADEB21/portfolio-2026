---
// src/components/atoms/FormField.astro
import type { HTMLAttributes } from "astro/types";

interface BaseProps {
  label: string;
  name: string;
  error?: string[] | undefined;
  required?: boolean;
}

type InputProps = BaseProps &
  HTMLAttributes<"input"> & {
    as?: "input";
  };

type TextareaProps = BaseProps &
  HTMLAttributes<"textarea"> & {
    as: "textarea";
    rows?: number;
  };

type Props = InputProps | TextareaProps;

const {
  label,
  name,
  error,
  required = false,
  as = "input",
  class: className,
  ...rest
} = Astro.props;

const errorId = `${name}-error`;
const hasError = Boolean(error && error.length > 0);
---

<div class:list={["form-field", { "has-error": hasError }, className]}>
  <label for={name} class="form-field__label">
    {label}
    {required && <span class="form-field__required">*</span>}
  </label>

  {
    as === "textarea" ? (
      <textarea
        id={name}
        name={name}
        required={required}
        aria-invalid={hasError ? "true" : undefined}
        aria-describedby={hasError ? errorId : undefined}
        class="form-field__control form-field__control--textarea"
        {...(rest as HTMLAttributes<"textarea">)}
      />
    ) : (
      <input
        id={name}
        name={name}
        required={required}
        aria-invalid={hasError ? "true" : undefined}
        aria-describedby={hasError ? errorId : undefined}
        class="form-field__control"
        {...(rest as HTMLAttributes<"input">)}
      />
    )
  }

  {
    hasError && (
      <p id={errorId} class="form-field__error" role="alert">
        {error![0]}
      </p>
    )
  }
</div>

<style>
  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs, 0.35rem);
    width: 100%;
  }

  .form-field__label {
    font-size: var(--text-xs, 0.8rem);
    font-weight: var(--font-weight-semibold, 600);
    color: var(--text-main, #0f0806);
    letter-spacing: var(--tracking-wide, 0.02em);
  }

  .form-field__required {
    color: var(--color-copper, #b85b35);
    margin-left: 0.2rem;
  }

  .form-field__control {
    width: 100%;
    padding: 0.75rem 1rem;
    font-family: inherit;
    font-size: var(--text-sm, 0.9rem);
    color: var(--text-main, #0f0806);
    background-color: var(--bg-main, #fbf7ee);
    border: 1px solid var(--border-color, rgba(76, 43, 36, 0.18));
    border-radius: var(--radius-sm, 8px);
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease;
  }

  .form-field__control:focus {
    outline: none;
    border-color: var(--color-copper, #b85b35);
    box-shadow: 0 0 0 3px rgba(184, 91, 53, 0.15);
  }

  .form-field__control--textarea {
    min-height: 120px;
    resize: vertical;
    line-height: 1.5;
  }

  /* Gestion visuelle des erreurs */
  .has-error .form-field__control {
    border-color: #fe5f56;
    background-color: rgba(254, 95, 86, 0.03);
  }

  .has-error .form-field__control:focus {
    box-shadow: 0 0 0 3px rgba(254, 95, 86, 0.18);
  }

  .form-field__error {
    margin: 0;
    font-size: var(--text-xs, 0.75rem);
    font-family: var(--font-mono, ui-monospace, monospace);
    color: #fe5f56;
    line-height: 1.3;
  }
</style>