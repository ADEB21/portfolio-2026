---
// src/components/ProjectCard.astro
import { Image } from 'astro:assets';
import { urlFor } from '../../assets/script/utils/image';
import type { Project } from '../../types';
import CircleButton from '../CircleButton.astro';

interface Props {
  project: Project;
}

const { project} = Astro.props;

const coverImageUrl = project.coverImage?.asset
  ? urlFor(project.coverImage.asset)
      .width(800)
      .auto('format')
      .url()
  : null;
---

<article class={`bento-card ${project.isLarge ? 'span-2' : ''} card`} data-categories={JSON.stringify(project.categories.map((cat) => cat.title) || [])}>
  <div class="project-content">
    <div class="project-top-meta">
      <div class="category-meta-group">
        <span class="category-names">
          {project.categories?.map((cat) => cat.title).join(' · ')}
        </span>
      </div>

      <span class="project-year-badge">{project.year}</span>
    </div>

    <div class="project-body">
      <h3 class="project-title">{project.title}</h3>
      <p class="project-desc">{project.description}</p>
    </div>

    <div class="project-footer">
      <div class="tech-pills">
        {project.tags?.map((tag: string) => (
          <span class="tag-pill">{tag}</span>
        ))}
      </div>

      {project.link && (
        <CircleButton link={project.link} isBlank={true} ariaLabel={`Voir le projet ${project.title}`}/>
      )}
    </div>
  </div>

  {project.isLarge && coverImageUrl && (
    <div class="project-image-wrapper">
      <Image
        src={coverImageUrl}
        width={700}
        height={450}
        alt={project.coverImage?.alt || `Aperçu du projet ${project.title}`}
        class="project-image"
      />
    </div>
  )}
</article>

<style>
  /* Version Pleine Largeur (Span-2) */
  .span-2 {
    grid-column: span 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-l);
    align-items: stretch;
  }

  .project-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: 1.5rem;
  }

  /* Catégories & Année */
  .project-top-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .category-meta-group {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .category-names {
    color: #6B5B54;
    font-weight: 600;
  }

  .project-year-badge {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    font-weight: 600;
    color: #B85B35;
    background: rgba(184, 91, 53, 0.1);
    padding: 3px 9px;
    border-radius: 6px;
  }

  /* Titre & Description */
  .project-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .project-title {
    font-family: var(--font-serif, "Fraunces", Georgia, serif);
    font-size: 1.75rem;
    font-weight: 600;
    color: #2B1810;
    line-height: 1.2;
    margin: 0;
  }

  .project-desc {
    color: #5A4A42;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Pied de carte & Tags */
  .project-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(76, 43, 36, 0.1);
    padding-top: 1rem;
    gap: 1rem;
  }

  .tech-pills {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag-pill {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    background: #FFFFFF;
    border: 1px solid rgba(76, 43, 36, 0.14);
    padding: 3px 9px;
    border-radius: 9999px;
    color: #2B1810;
    font-weight: 500;
  }

  /* Image Span-2 intégrée */
  .project-image-wrapper {
    width: 100%;
    height: 100%;
    min-height: 280px;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    border: 1px solid rgba(76, 43, 36, 0.08);
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 16px;
    transition: transform 0.4s ease;
  }

  .card:hover .project-image {
    transform: scale(1.03);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .card.span-2 {
      grid-column: span 1;
      grid-template-columns: 1fr;
      gap: var(--space-md);;
    }

    .project-image-wrapper {
      min-height: 220px;
      max-height: 320px;
    }
  }
</style>