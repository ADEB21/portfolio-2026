---
const today = new Date();
---

<!-- Footer -->
<footer class="warm-footer">
  <div class="footer-left">
    <h4>Donnons vie à votre prochain projet</h4>
    <p>© 2026 Arthur DEBRUILLE &bull; Réalisé avec Astro & Sanity CMS</p>
  </div>
  <a href="mailto:contact@example.com" class="btn-pill-primary">
    <span>Initier un échange</span>
    <span>&rarr;</span>
  </a>
</footer>

<style>
  /* 9. Footer */
  footer.warm-footer {
    background: var(--bg-card-solid);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-3xl);
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: var(--shadow-md);
  }

  .footer-left h4 {
    font-size: var(--text-2xl);
    font-weight: 600;
    margin-bottom: var(--space-2xs);
  }

  .footer-left p {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 768px) {
    footer.warm-footer {
      flex-direction: column;
      gap: var(--space-lg);
      text-align: center;
      padding: var(--space-xl);
    }
  }
</style>
