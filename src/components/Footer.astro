---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();

const socialLinks = [
  { name: 'LinkedIn', url: 'https://linkedin.com/in/arthurdebruille' },
  { name: 'GitHub', url: 'https://github.com/ADEB21' },
  { name: 'Email direct', url: 'mailto:arthurdebruille@proton.me' },
];

const navigationLinks = [
  { label: 'Projets', href: '#projets' },
  { label: 'Compétences', href: '#competences' },
  { label: 'Expériences', href: '#experiences' },
  { label: 'Formations & Certifications', href: '#formations' },
  { label: 'Hub Projets', href: '/projets' },
];
---

<footer class="footer">
  <div class="footer-inner">

    <!-- 2. Grille Principale (4 Colonnes) -->
    <div class="footer-grid">
      <!-- Colonne 1 : Profil -->
      <div class="footer-col brand-col">
        <div class="footer-brand">Arthur Debruille</div>
        <p class="footer-tagline">
          Développeur Front-End spécialisé dans l’écosystème React, la performance et le design d’interfaces soignées.
        </p>
        <div class="footer-status">
          <span class="status-dot"></span>
          <span>Disponible pour nouveaux projets</span>
        </div>
      </div>

      <!-- Colonne 2 : Navigation -->
      <div class="footer-col">
        <h3 class="col-title">Navigation</h3>
        <ul class="footer-links-list">
          {navigationLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Colonne 3 : Réseaux -->
      <div class="footer-col">
        <h3 class="col-title">Connexions</h3>
        <ul class="footer-links-list">
          {socialLinks.map((social) => (
            <li>
              <a href={social.url} target="_blank" rel="noopener noreferrer" class="social-link-item">
                <span>{social.name}</span>
                <span class="ext-arrow">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Colonne 4 : Infos -->
      <div class="footer-col">
        <h3 class="col-title">Détails</h3>
        <div class="details-stack">
          <div>
            <span class="detail-label">Localisation</span>
            <p class="detail-val">Dijon & Remote, France</p>
          </div>
          <div>
            <span class="detail-label">Stack du portfolio</span>
            <p class="detail-val">Astro &bull; Sanity CMS</p>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Bas de page / Copyright -->
    <div class="footer-bottom-bar">
      <p class="copyright-text">
        &copy; {currentYear} Arthur Debruille &bull; Développeur Front-End React
      </p>
      <a href="#" class="back-to-top" aria-label="Retour en haut de page">
        <span>Haut de page</span>
        <span>&uarr;</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid rgba(76, 43, 36, 0.16);
    padding: 5rem 0 2rem 0;
    box-sizing: border-box;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    box-sizing: border-box;
  }

  /* Grille */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 2.5rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .col-title {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #8C7A70;
    margin: 0 0 0.5rem 0;
  }

  .footer-brand {
    font-family: "Fraunces", Georgia, serif;
    font-size: var(--text-2xl);
    font-weight: 600;
    color: #2B1810;
  }

  .footer-tagline {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #5A4A42;
    margin: 0;
  }

  .footer-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.75rem;
    color: #2B1810;
    background: rgba(46, 125, 50, 0.08);
    border: 1px solid rgba(46, 125, 50, 0.2);
    padding: 5px 12px;
    border-radius: 9999px;
    width: fit-content;
    margin-top: 0.25rem;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2E7D32;
    box-shadow: 0 0 6px rgba(46, 125, 50, 0.6);
  }

  /* Listes */
  .footer-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links-list a {
    font-size: 0.92rem;
    color: #5A4A42;
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    width: fit-content;
  }

  .footer-links-list a:hover {
    color: #B85B35;
    transform: translateX(3px);
  }

  .social-link-item {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.85rem !important;
  }

  .ext-arrow {
    font-size: 0.75rem;
    color: #B85B35;
  }

  /* Colonne Détails */
  .details-stack {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .detail-label {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.7rem;
    color: #8C7A70;
    text-transform: uppercase;
    display: block;
    margin-bottom: 2px;
  }

  .detail-val {
    font-size: 0.9rem;
    color: #2B1810;
    font-weight: 500;
    margin: 0;
  }

  .studio-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.75rem;
    color: #2B1810;
    background: rgba(76, 43, 36, 0.06);
    border: 1px solid rgba(76, 43, 36, 0.14);
    padding: 5px 12px;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.2s ease;
    width: fit-content;
  }

  .studio-link:hover {
    background: #2B1810;
    color: #FBF7EE;
  }

  /* Barre inférieure */
  .footer-bottom-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(76, 43, 36, 0.1);
    padding-top: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .copyright-text {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.78rem;
    color: #8C7A70;
    margin: 0;
  }

  .back-to-top {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.78rem;
    color: #2B1810;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.15s ease;
  }

  .back-to-top:hover {
    color: #B85B35;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .footer-cta-block {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-bottom-bar {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }
</style>