---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TechIcon from "../components/TechIcon";
import { sanityClient } from "sanity:client";
import type { Profile, Project } from "../types";
import SkillCard from "../components/SkillCard.astro";

// 3. COMPÉTENCES & STACK (4 Blocs équilibrés avec slugs Iconify)
const skillsCategories = [
  {
    tag: "FRAMEWORKS & RUNTIME",
    title: "Langages et Frameworks",
    description: "Architecture d'applications modulaires, typées et réactives.",
    technologies: [
      { name: "React.js", slug: "react" },
      { name: "Next.js", slug: "nextjs" },
      { name: "Astro", slug: "astro" },
      { name: "TypeScript", slug: "typescript" },
      { name: "JavaScript", slug: "javascript" },
      { name: "Vue.js", slug: "vuejs" },
      { name: "HTML5", slug: "html5" },
      { name: "CSS3 / Sass", slug: "sass" },
    ],
  },
  {
    tag: "UI & DESIGN SYSTEM",
    title: "Design et Intégration",
    description: "Fidélité au pixel près, ergonomie et accessibilité.",
    technologies: [
      { name: "Tailwind CSS", slug: "tailwind" },
      { name: "Figma", slug: "figma" },
      { name: "Storybook", slug: "storybook" },
      { name: "Responsive UI", slug: "responsive" },
      { name: "a11y (WCAG)", slug: "a11y" },
    ],
  },
  {
    tag: "TOOLING & DEVOPS",
    title: "Outillage et Déploiement",
    description: "Pipelines de livraison continue, bundling et hébergement.",
    technologies: [
      { name: "Git", slug: "git" },
      { name: "GitHub", slug: "github" },
      { name: "Vite", slug: "vite" },
      { name: "Webpack", slug: "webpack" },
      { name: "Vercel", slug: "vercel" },
      { name: "Netlify", slug: "netlify" },
    ],
  },
  {
    tag: "METHOD & INNOVATION",
    title: "Méthodologie et IA",
    description:
      "Standards de code, gestion agile et intégration de workflows IA.",
    technologies: [
      { name: "Agile / Scrum", slug: "agile" },
      { name: "Revue de code", slug: "codereview" },
      { name: "API REST", slug: "api" },
      { name: "LLM & IA locale", slug: "ai" },
    ],
  },
];

// 4. EXPÉRIENCES PROFESSIONNELLES (Bihua & Freelance)
const experiences = [
  {
    dates: "Octobre 2025 — Aujourd’hui",
    company: "Bihua & Projets Personnels",
    role: "Développeur Front-End (Freelance & R&D)",
    details:
      "Missions freelance de développement Front-End (React.js, Astro.js) pour Bihua. Expérimentations techniques, certifications Meta (Front-End, JS, Git) et intégration de workflows IA générative / LLM en local.",
    contract: "Freelance & R&D",
  },
  {
    dates: "Septembre 2023 — Octobre 2025",
    company: "Bihua (Lyon)",
    role: "Développeur Front-End",
    details:
      "Référent Front-End sur 6 projets en parallèle (Finance, IT, Culture, Œnologie). Optimisation des performances (-75% de ressources, gain Lighthouse), renforcement de l'accessibilité (+40%), mise en place des standards de code et interlocuteur technique direct des clients.",
    contract: "Poste clé",
  },
  {
    dates: "Septembre 2022 — Août 2023",
    company: "Bihua (Lyon)",
    role: "Développeur Front-End Junior",
    details:
      "Développement de composants React.js réutilisables, intégration responsive de maquettes HTML/CSS, maintenance corrective et évolutive sur 4 sites existants au sein d'une équipe Agile de 4 personnes.",
    contract: "Alternance",
  },
];

// 5. DIPLÔMES & CERTIFICATIONS META
const educationList = [
  {
    years: "2023 — 2025",
    degree: "Master Expert du Design Numérique",
    school: "ESADD",
    summary:
      "Mémoire de recherche appliquée sur l'intégration de technologies innovantes (blockchain) comme levier d'innovation en entreprise.",
  },
  {
    years: "2020 — 2023",
    degree: "Bachelor Designer Numérique",
    school: "ESADD",
    summary:
      "Formation complète en design numérique, conception d'interfaces, ergonomie UX/UI et fondamentaux du développement web front-end.",
  },
];

const certificationsList = [
  {
    title: "Version Control",
    issuer: "Meta",
    date: "Juil. 2026",
    credentialId: "MSP1Y6GT2P35",
    skills: ["Git", "GitHub", "Branching Workflows"],
  },
  {
    title: "Programming with JavaScript",
    issuer: "Meta",
    date: "Juin 2026",
    credentialId: "G3I3KAJ6OFQV",
    skills: ["JavaScript (ES6+)", "DOM Manipulation", "Testing"],
  },
  {
    title: "Introduction to Front-End Development",
    issuer: "Meta",
    date: "Avr. 2026",
    credentialId: "SK55GTXOP01T",
    skills: ["HTML5", "CSS3", "UI Architecture"],
  },
];

const profile: Profile = await sanityClient.fetch(`*[_type == "profile"][0]`);
const featuredProjects: Project[] = await sanityClient.fetch(
  `*[_type == "project" && isFeatured == true] | order(order asc) {
  _id,
  title,
  "slug": slug.current,
  category,
  year,
  description,
  tags,
  link,
  isLarge,
  coverImage
}`,
);
---

<Layout title={`${profile.name} — ${profile.role}`} description="Bienvenue sur mon Portfolio">
  <main>
    <!-- HERO -->
    <section class="hero-editorial">
      <div class="hero-top-row">
        <div class="hero-status-tag">
          <span class="status-indicator"></span>
          <span>{profile.tagline}</span>
        </div>
      </div>

      <div class="hero-body">
        <h1 class="hero-title">
          Développeur Front-End & <br />
          <em>Architecte d'Interfaces React.</em>
        </h1>
        <p class="hero-bio">
          {profile.bio}
        </p>
      </div>

      <div class="hero-footer-row">
        <div class="hero-actions">
          <a href="#projets" class="btn-pill-primary">
            <span>Explorer les projets</span>
            <span>↓</span>
          </a>
          <a href="mailto:arthurdebruille@proton.me" class="btn-pill-secondary">
            <span>Prendre contact</span>
          </a>
        </div>
      </div>
    </section>
    <!-- PROJETS -->
    <section id="projets" style="margin-bottom: var(--space-l);">
      <div class="section-header">
        <div>
          <span class="section-badge">// Réalisations</span>
          <h2 class="section-title">Projets</h2>
          <p class="section-subtitle">
            Une sélection de travaux récents alliant architecture modulaire,
            performance extrême et design soigné.
          </p>
        </div>
      </div>

      <div class="featured-projects-grid">
        {featuredProjects.map((p) => <ProjectCard project={p} />)}
      </div>

      <!-- Redirection Hub Projets -->
      <div class="hub-redirect-card">
        <div class="hub-content">
          <h4>Envie d'explorer plus d'études de cas ?</h4>
          <p>
            Accédez à l'ensemble des projets, prototypes interactifs et dépôts
            GitHub.
          </p>
        </div>
        <a href="/projects" class="btn-pill-primary">
          <span>Consulter le Hub Projets</span>
          <span>&rarr;</span>
        </a>
      </div>
    </section>
    <!-- COMPÉTENCES & STACK -->
    <section id="competences" style="margin-bottom: var(--space-4xl);">
      <div class="section-header">
        <div>
          <span class="section-badge">// Savoir-faire</span>
          <h2 class="section-title">Compétences & Écosystème</h2>
          <p class="section-subtitle">
            Un socle technique axé sur l’écosystème React et le web moderne,
            combinant rigueur d’architecture, intégration fidèle au pixel près,
            accessibilité (a11y) et optimisation des performances pour des
            interfaces fluides et durables.
          </p>
        </div>
      </div>

      <div class="skills-bento-grid">
        {skillsCategories.map((skill) => <SkillCard skill={skill} />)}
      </div>
    </section>

    <!-- EXPÉRIENCES PRO -->
    <section id="experiences" style="margin-bottom: var(--space-4xl);">
      <div class="section-header">
        <div>
          <span class="section-badge">// Parcours</span>
          <h2 class="section-title">Expériences Professionnelles</h2>
          <p class="section-subtitle">
            Mon parcours en agence, missions freelance et accompagnement
            technique de clients.
          </p>
        </div>
      </div>

      <div class="experiences-wrapper">
        {
          experiences.map((exp) => (
            <article class="bento-card exp-card">
              <div>
                <div class="exp-dates">{exp.dates}</div>
                <div class="exp-company">{exp.company}</div>
              </div>
              <div>
                <h3 class="exp-role">{exp.role}</h3>
                <p class="exp-details">{exp.details}</p>
              </div>
              <div>
                <span class="exp-contract">{exp.contract}</span>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- FORMATIONS & CERTIFICATIONS -->
    <section id="formations" style="margin-bottom: var(--space-4xl);">
      <div class="section-header">
        <div>
          <span class="section-badge">// Formations</span>
          <h2 class="section-title">Diplômes & Certifications</h2>
          <p class="section-subtitle">
            Double cursus universitaire en design numérique complété par des
            certifications professionnelles Meta.
          </p>
        </div>
      </div>
      <div class="education-grid">
        {
          educationList.map((edu) => (
            <article class="bento-card edu-card">
              <div>
                <div class="edu-year">{edu.years}</div>
                <h3 class="edu-degree">{edu.degree}</h3>
                <p class="edu-school">{edu.school}</p>
              </div>
              <p class="edu-summary">{edu.summary}</p>
            </article>
          ))
        }
      </div>
      <div class="certifications-grid">
        {
          certificationsList.map((cert) => (
            <article class="bento-card cert-card-modern">
              <div class="cert-top-bar">
                <div class="meta-logo-box">
                  <TechIcon name="meta" size={18} client:idle />
                  <span>{cert.issuer}</span>
                </div>
                <span class="cert-date-badge">{cert.date}</span>
              </div>

              <div>
                <h4 class="cert-title">{cert.title}</h4>
                <span class="cert-id-tag">ID : {cert.credentialId}</span>
              </div>

              <div class="cert-skills-pills">
                {cert.skills.map((skill) => (
                  <span class="tag-pill">{skill}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  /* 3. Bento Card Base */
  .bento-card {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: var(--shadow-card);
    transition:
      transform var(--duration-base) var(--ease-spring),
      border-color var(--duration-base) ease,
      box-shadow var(--duration-base) ease;
    position: relative;
    overflow: hidden;
  }

  .bento-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .card-halo {
    position: absolute;
    top: -120px;
    right: -120px;
    width: 260px;
    height: 260px;
    background: radial-gradient(
      circle,
      rgba(214, 194, 154, 0.4) 0%,
      transparent 70%
    );
    pointer-events: none;
    filter: blur(40px);
  }

  /* Hero Pleine Largeur Éditorial (Sans Card) */
  .hero-editorial {
    width: 100%;
    padding-bottom: var(--space-4xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    position: relative;
  }

  /* En-tête : Disponibilité & Localisation */
  .hero-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .hero-status-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-espresso);
    background: rgba(251, 247, 238, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-light);
    padding: 6px 14px;
    border-radius: var(--radius-full);
  }

  .status-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-success);
    box-shadow: 0 0 8px rgba(46, 125, 50, 0.6);
  }

  /* Corps du texte */
  .hero-body {
    max-width: 920px;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: var(--tracking-tighter);
    color: var(--text-espresso);
    margin-bottom: var(--space-l);
  }

  .hero-title em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-copper);
  }

  .hero-bio {
    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
    max-width: 820px;
  }

  /* Boutons d'action */
  .hero-footer-row {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding-top: var(--space-s);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    flex-wrap: wrap;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-editorial {
      padding: var(--space-l) 0 var(--space-3xl) 0;
      gap: var(--space-l);
    }

    .hero-top-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* 5. Projets */
  .featured-projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-l);
  }

  .hub-redirect-card {
    background: linear-gradient(
      135deg,
      var(--bg-card-solid),
      var(--color-sand-soft)
    );
    border: 1px dashed var(--border-dash);
    border-radius: var(--radius-xl);
    padding: var(--space-l) var(--space-3xl);
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4xl);
    box-shadow: var(--shadow-sm);
  }

  .hub-content h4 {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-bottom: var(--space-3xs);
  }

  .hub-content p {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  /* 6. Compétences (Grille 2x2 Bento avec Pastilles) */
  .skills-bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-l);
    margin-bottom: var(--space-4xl);
  }

  /* 7. Expériences */
  .experiences-wrapper {
    display: grid;
    gap: var(--space-s);
    margin-bottom: var(--space-4xl);
  }

  .exp-card {
    padding: var(--space-l) var(--space-2xl);
    display: grid;
    grid-template-columns: 240px 1fr auto;
    gap: var(--space-l);
    align-items: center;
  }

  .exp-dates {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-copper);
    font-weight: 600;
    margin-bottom: var(--space-3xs);
  }

  .exp-company {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-lg);
  }

  .exp-role {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 700;
    margin-bottom: var(--space-3xs);
  }

  .exp-details {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .exp-contract {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    background: var(--bg-subtle);
    border: 1px solid var(--border-light);
    padding: 5px 14px;
    border-radius: var(--radius-full);
    color: var(--text-dim);
  }

  /* 8. Formations & Certifications */
  .education-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .edu-card {
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .edu-year {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-copper);
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .edu-degree {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-bottom: var(--space-3xs);
  }

  .edu-school {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }

  .edu-summary {
    font-size: var(--text-sm);
    color: var(--text-dim);
    border-top: 1px solid var(--border-light);
    padding-top: var(--space-md);
    line-height: var(--leading-relaxed);
  }

  .certifications-wrapper {
    margin-top: var(--space-2xl);
  }

  .certifications-heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    margin-bottom: var(--space-md);
  }

  .certifications-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .cert-card-modern {
    padding: var(--space-l);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-md);
    background: var(--bg-card-solid);
  }

  .cert-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .meta-logo-box {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--text-xs);
    background: var(--bg-subtle);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-light);
  }

  .cert-date-badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-dim);
  }

  .cert-title {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-espresso);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-3xs);
  }

  .cert-id-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-dim);
  }

  .cert-skills-pills {
    display: flex;
    gap: var(--space-3xs);
    flex-wrap: wrap;
    border-top: 1px solid var(--border-light);
    padding-top: var(--space-xs);
  }

  /* 10. Responsive */
  @media (max-width: 1024px) {
    .skills-bento-grid,
    .education-grid,
    .certifications-grid {
      grid-template-columns: 1fr;
    }
    .project-card-large.span-2 {
      grid-column: span 1;
      grid-template-columns: 1fr;
    }
    .featured-projects-grid {
      grid-template-columns: 1fr;
    }
    .exp-card {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }
  }

  @media (max-width: 768px) {
    .hero-full-card {
      padding: var(--space-l);
    }
    .hero-top-row,
    .hero-footer-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .hub-redirect-card {
      flex-direction: column;
      gap: var(--space-md);
      text-align: center;
      padding: var(--space-md);
    }
    footer.warm-footer {
      flex-direction: column;
      gap: var(--space-md);
      text-align: center;
      padding: var(--space-l);
    }
    .nav-links {
      display: none;
    }
  }
</style>

<script define:vars={{ featuredProjects }}>
  console.log(featuredProjects);
</script>
