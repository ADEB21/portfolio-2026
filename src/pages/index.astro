---
import { sanityClient } from "sanity:client";
import type {
  Category,
  Certificate,
  Experience,
  Post,
  Profile,
} from "@@types/index";
import {
  CERTIFICATES_QUERY,
  DEGREES_QUERY,
  EXPERIENCES_QUERY,
  PROFILE_QUERY,
  PROJECTS_FEATURED_QUERY,
  SKILLS_CATEGORIES_QUERY,
} from "@assets/script/utils/api";

// Components
import Layout from "@layout/Layout.astro";
import HubProjectsRedirection from "@components/molecules/HubProjectsRedirection.astro";


// Cards
import SkillCategoryCard from "@components/molecules/Cards/SkillCategoryCard.astro";
import ExperienceCard from "@components/molecules/Cards/ExperienceCard.astro";
import CertificateCard from "@components/molecules/Cards/CertificateCard.astro";
import Hero from "@components/organisms/Hero.astro";
import PostCard from "@components/molecules/Cards/PostCard.astro";

const profile: Profile = await sanityClient.fetch(PROFILE_QUERY);
const featuredProjects: Post[] =
  await sanityClient.fetch(PROJECTS_FEATURED_QUERY);
const skillsCategories: Category[] = await sanityClient.fetch(
  SKILLS_CATEGORIES_QUERY,
);
const experiences: Experience[] = await sanityClient.fetch(EXPERIENCES_QUERY);
const educationList: Certificate[] = await sanityClient.fetch(DEGREES_QUERY);
const certificationsList: Certificate[] =
  await sanityClient.fetch(CERTIFICATES_QUERY);
---

<Layout
  title={`${profile.name} — ${profile.role}`}
  description="Bienvenue sur mon Portfolio"
>
  <main>
    <!-- A PROPOS -->
    <Hero
      id="apropos"
      title="Développeur Front-End &"
      subtitle="Architecte d'Interfaces React."
      summary={profile.bio}
      primaryButton={{
        label: "Explorer les projets",
        href: "#projets",
        ariaLabel: "Explorer les projets mis en avant",
      }}
      secondaryButton={{
        label: "Prendre contact",
        href: "mailto:arthurdebruille@proton.me",
        ariaLabel: "Prendre contact",
      }}
    />
    <!-- PROJETS -->
    <section id="projets">
      <div class="section-header">
        <div>
          <span class="eyebrow">// Réalisations</span>
          <h2 class="section-title">Projets</h2>
          <p class="section-subtitle">
            Une sélection de travaux récents alliant architecture modulaire,
            performance et design soigné.
          </p>
        </div>
      </div>

      <div class="featured-projects-grid">
        {featuredProjects.map((p) => <PostCard post={p} />)}
      </div>
      <HubProjectsRedirection />
    </section>
    <!-- COMPÉTENCES & STACK -->
    <section id="competences">
      <div class="section-header">
        <div>
          <span class="eyebrow">// Savoir-faire</span>
          <h2 class="section-title">Compétences & Écosystème</h2>
          <p class="section-subtitle">
            Un socle technique axé sur l’écosystème React et le web moderne,
            combinant rigueur d’architecture, intégration fidèle au pixel près,
            accessibilité (a11y) et optimisation des performances pour des
            interfaces fluides et durables.
          </p>
        </div>
      </div>

      <div class="skills-catergories-grid">
        {skillsCategories.map((cat) => <SkillCategoryCard cat={cat} />)}
      </div>
    </section>
    <!-- EXPÉRIENCES PRO -->
    <section id="experiences">
      <div class="section-header">
        <div>
          <span class="eyebrow">// Parcours</span>
          <h2 class="section-title">Expériences Professionnelles</h2>
          <p class="section-subtitle">
            Mon parcours en agence, missions freelance et accompagnement
            technique de clients.
          </p>
        </div>
      </div>

      <div class="experiences-grid">
        {experiences.map((exp) => <ExperienceCard experience={exp} />)}
      </div>
    </section>
    <!-- DIPLÔMES & CERTIFICATIONS -->
    <section id="formations">
      <div class="section-header">
        <div>
          <span class="eyebrow">// Formations</span>
          <h2 class="section-title">Diplômes & Certifications</h2>
          <p class="section-subtitle">
            Double cursus universitaire en design numérique complété par des
            certifications professionnelles Meta.
          </p>
        </div>
      </div>
      <div class="education-grid">
        {educationList.map((edu) => <CertificateCard certification={edu} />)}
      </div>
      <hr
        style="margin: var(--space-xl) 0; border-color: var(--border-light);"
      />
      <div class="certifications-grid">
        {
          certificationsList.map((cert) => (
            <CertificateCard certification={cert} />
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  /* 1. Projets */
  .featured-projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-l);
  }

  /* 2. Compétences */
  .skills-catergories-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-l);
  }

  /* 3. Expériences */
  .experiences-grid {
    display: grid;
    gap: var(--space-s);
  }

  /* 4. Diplômes & Certifications */
  .education-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .certifications-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .featured-projects-grid,
    .skills-catergories-grid,
    .education-grid,
    .certifications-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
