---
import { sanityClient } from "sanity:client";
import type { Profile, Project } from "../types";

// Components
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import HubProjectsRedirection from "../components/HubProjectsRedirection.astro";

// Buttons
import PrimaryButton from "../components/PrimaryButton.astro";
import SecondaryButton from "../components/SecondaryButton.astro"

// Cards
import ProjectCard from "../components/Cards/ProjectCard.astro";
import SkillCategoryCard from "../components/Cards/SkillCategoryCard.astro";
import ExperienceCard from "../components/Cards/ExperienceCard.astro";
import CertificateCard from "../components/Cards/CertificateCard.astro";

// 3. COMPÉTENCES & STACK (4 Blocs équilibrés avec slugs Iconify)
const skillsCategories = [
  {
    tag: "FRAMEWORKS & RUNTIME",
    title: "Langages et Frameworks",
    description: "Architecture d'applications modulaires, typées et réactives.",
    skills: [
      { name: "React.js", slug: "react" },
      { name: "Next.js", slug: "nextjs" },
      { name: "Astro", slug: "astro" },
      { name: "TypeScript", slug: "typescript" },
      { name: "JavaScript", slug: "javascript" },
      { name: "Vue.js", slug: "vuejs" },
      { name: "HTML5", slug: "html5" },
      { name: "CSS3 / Sass", slug: "sass" },
    ],
  },
  {
    tag: "UI & DESIGN SYSTEM",
    title: "Design et Intégration",
    description: "Fidélité au pixel près, ergonomie et accessibilité.",
    skills: [
      { name: "Tailwind CSS", slug: "tailwind" },
      { name: "Figma", slug: "figma" },
      { name: "Storybook", slug: "storybook" },
      { name: "Responsive UI", slug: "responsive" },
      { name: "a11y (WCAG)", slug: "a11y" },
    ],
  },
  {
    tag: "TOOLING & DEVOPS",
    title: "Outillage et Déploiement",
    description: "Pipelines de livraison continue, bundling et hébergement.",
    skills: [
      { name: "Git", slug: "git" },
      { name: "GitHub", slug: "github" },
      { name: "Vite", slug: "vite" },
      { name: "Webpack", slug: "webpack" },
      { name: "Vercel", slug: "vercel" },
      { name: "Netlify", slug: "netlify" },
    ],
  },
  {
    tag: "METHOD & INNOVATION",
    title: "Méthodologie et IA",
    description:
      "Standards de code, gestion agile et intégration de workflows IA.",
    skills: [
      { name: "Agile / Scrum", slug: "agile" },
      { name: "Revue de code", slug: "codereview" },
      { name: "API REST", slug: "api" },
      { name: "LLM & IA locale", slug: "ai" },
    ],
  },
];

// 4. EXPÉRIENCES PROFESSIONNELLES (Bihua & Freelance)
const experiences = [
  {
    dates: "Octobre 2025 — Aujourd’hui",
    company: "Bihua & Projets Personnels",
    role: "Développeur Front-End (Freelance & R&D)",
    details:
      "Missions freelance de développement Front-End (React.js, Astro.js) pour Bihua. Expérimentations techniques, certifications Meta (Front-End, JS, Git) et intégration de workflows IA générative / LLM en local.",
    contract: "Freelance & R&D",
  },
  {
    dates: "Septembre 2023 — Octobre 2025",
    company: "Bihua (Lyon)",
    role: "Développeur Front-End",
    details:
      "Référent Front-End sur 6 projets en parallèle (Finance, IT, Culture, Œnologie). Optimisation des performances (-75% de ressources, gain Lighthouse), renforcement de l'accessibilité (+40%), mise en place des standards de code et interlocuteur technique direct des clients.",
    contract: "Poste clé",
  },
  {
    dates: "Septembre 2022 — Août 2023",
    company: "Bihua (Lyon)",
    role: "Développeur Front-End Junior",
    details:
      "Développement de composants React.js réutilisables, intégration responsive de maquettes HTML/CSS, maintenance corrective et évolutive sur 4 sites existants au sein d'une équipe Agile de 4 personnes.",
    contract: "Alternance",
  },
];

// 5. DIPLÔMES & CERTIFICATIONS META
const educationList = [
  {
    _type: "degree",
    title: "Master Expert du Design Numérique",
    issuer: "ESADD",
    date: "2023 — 2025",
    credentialId: "RNCP39855",
    summary:
      "Mémoire de recherche appliquée sur l'intégration de technologies innovantes (blockchain) comme levier d'innovation en entreprise.",
  },
  {
    _type: "degree",
    title: "Bachelor Designer Numérique",
    issuer: "ESADD",
    date: "2020 — 2023",
    credentialId: "RNCP39764",
    summary:
      "Formation complète en design numérique, conception d'interfaces, ergonomie UX/UI et fondamentaux du développement web front-end.",
  },
];

const certificationsList = [
  {
    _type: "certificate",
    title: "Version Control",
    issuer: "Meta",
    date: "Juil. 2026",
    credentialId: "MSP1Y6GT2P35",
    skills: [
      { name: "Git", slug: "git" },
      { name: "GitHub", slug: "github" },
      { name: "Branching Workflows", slug: "branch" },
    ],
  },
  {
    _type: "certificate",
    title: "Programming with JavaScript",
    issuer: "Meta",
    date: "Juin 2026",
    credentialId: "G3I3KAJ6OFQV",
    skills: [
      { name: "JavaScript", slug: "javascript" },
      { name: "DOM Manipulation", slug: "dom" },
      { name: "Testing", slug: "testing" },
    ],
  },
  {
    _type: "certificate",
    title: "Introduction to Front-End Development",
    issuer: "Meta",
    date: "Avr. 2026",
    credentialId: "SK55GTXOP01T",
    skills: [
      { name: "HTML5", slug: "html5" },
      { name: "CSS3", slug: "css3" },
      { name: "UI Architecture", slug: "ui" },
    ],
  },
];

const profile: Profile = await sanityClient.fetch(`*[_type == "profile"][0]`);
const featuredProjects: Project[] = await sanityClient.fetch(
  `*[_type == "project" && isFeatured == true] | order(order asc) {
  _id,
  title,
  "slug": slug.current,
  category,
  year,
  description,
  tags,
  link,
  isLarge,
  coverImage
}`,
);
---

<Layout
  title={`${profile.name} — ${profile.role}`}
  description="Bienvenue sur mon Portfolio"
>
  <Navigation />
  <main>
    <!-- HERO -->
    <section id="hero" class="hero">
      <div class="hero-top-row">
        <div class="hero-status-tag">
          <span class="status-indicator"></span>
          <span>{profile.tagline}</span>
        </div>
      </div>

      <div class="hero-body">
        <h1 class="hero-title">
          Développeur Front-End & <br />
          <em>Architecte d'Interfaces React.</em>
        </h1>
        <p class="hero-bio">
          {profile.bio}
        </p>
      </div>

      <div class="hero-footer-row">
        <div class="hero-actions">
          <PrimaryButton label="Explorer les projets ↓" link="#projets" ariaLabel="Aller à la page projets" />
          <SecondaryButton label="Prendre contact" link="mailto:arthurdebruille@proton.me" ariaLabel="Envoyer un mail" />
        </div>
      </div>
    </section>
    <!-- PROJETS -->
    <section id="projets">
      <div class="section-header">
        <div>
          <span class="section-badge">// Réalisations</span>
          <h2 class="section-title">Projets</h2>
          <p class="section-subtitle">
            Une sélection de travaux récents alliant architecture modulaire,
            performance extrême et design soigné.
          </p>
        </div>
      </div>

      <div class="featured-projects-grid">
        {featuredProjects.map((p) => <ProjectCard project={p} />)}
      </div>

      <!-- Redirection Hub Projets -->
      <HubProjectsRedirection />
    </section>
    <!-- COMPÉTENCES & STACK -->
    <section id="competences">
      <div class="section-header">
        <div>
          <span class="section-badge">// Savoir-faire</span>
          <h2 class="section-title">Compétences & Écosystème</h2>
          <p class="section-subtitle">
            Un socle technique axé sur l’écosystème React et le web moderne,
            combinant rigueur d’architecture, intégration fidèle au pixel près,
            accessibilité (a11y) et optimisation des performances pour des
            interfaces fluides et durables.
          </p>
        </div>
      </div>

      <div class="skills-catergories-grid">
        {skillsCategories.map((cat) => <SkillCategoryCard cat={cat} />)}
      </div>
    </section>
    <!-- EXPÉRIENCES PRO -->
    <section id="experiences">
      <div class="section-header">
        <div>
          <span class="section-badge">// Parcours</span>
          <h2 class="section-title">Expériences Professionnelles</h2>
          <p class="section-subtitle">
            Mon parcours en agence, missions freelance et accompagnement
            technique de clients.
          </p>
        </div>
      </div>

      <div class="experiences-grid">
        {experiences.map((exp) => <ExperienceCard experience={exp} />)}
      </div>
    </section>
    <!-- FORMATIONS & CERTIFICATIONS -->
    <section id="formations">
      <div class="section-header">
        <div>
          <span class="section-badge">// Formations</span>
          <h2 class="section-title">Diplômes & Certifications</h2>
          <p class="section-subtitle">
            Double cursus universitaire en design numérique complété par des
            certifications professionnelles Meta.
          </p>
        </div>
      </div>
      <div class="education-grid">
        {educationList.map((edu) => <CertificateCard certification={edu} />)}
      </div>
      <hr
        style="margin: var(--space-xl) 0; border-color: var(--border-light);"
      />
      <div class="certifications-grid">
        {
          certificationsList.map((cert) => (
            <CertificateCard certification={cert} />
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Hero Pleine Largeur Éditorial (Sans Card) */
  .hero {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    position: relative;
    margin-bottom: var(--space-4xl);
  }

  /* En-tête : Disponibilité & Localisation */
  .hero-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .hero-status-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-espresso);
    background: rgba(251, 247, 238, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-light);
    padding: 6px 14px;
    border-radius: var(--radius-full);
  }

  .status-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-success);
    box-shadow: 0 0 8px rgba(46, 125, 50, 0.6);
  }

  /* Corps du texte */
  .hero-body {
    max-width: 920px;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: var(--tracking-tighter);
    color: var(--text-espresso);
    margin-bottom: var(--space-l);
  }

  .hero-title em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-copper);
  }

  .hero-bio {
    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
    max-width: 820px;
  }

  /* Boutons d'action */
  .hero-footer-row {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding-top: var(--space-s);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    flex-wrap: wrap;
  }

  /* 5. Projets */
  .featured-projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-l);
  }

  /* 6. Compétences (Grille 2x2 Bento avec Pastilles) */
  .skills-catergories-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-l);
  }

  section#projets,
  section#competences,
  section#experiences,
  section#formations {
    margin-bottom: var(--space-4xl);
  }

  /* 7. Expériences */
  .experiences-grid {
    display: grid;
    gap: var(--space-s);
  }

  /* 8. Formations & Certifications */
  .education-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .certifications-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  /* 10. Responsive */
  @media (max-width: 768px) {
    .featured-projects-grid,
    .skills-catergories-grid,
    .education-grid,
    .certifications-grid {
      grid-template-columns: 1fr;
    }
    /* A mettre dans la card spéciale exp */
    .hub-redirect-card {
      flex-direction: column;
      gap: var(--space-md);
      text-align: center;
      padding: var(--space-md);
    }
  }
</style>

<script define:vars={{ featuredProjects }}>
  console.log(featuredProjects);
</script>
