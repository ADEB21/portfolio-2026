---
// Sanity
import { sanityClient } from "sanity:client";
import { ALL_PROJECTS_QUERY } from "../../assets/script/utils/api";

// Components
import Layout from "@layout/Layout.astro";
import Hero from "@components/organisms/Hero.astro";

// Types
import type { Project } from "@@types/index";
import PostsSections from "@components/organisms/PostsSections.astro";
import PostCard from "@components/molecules/Cards/PostCard.astro";

const projects: Project[] = await sanityClient.fetch(ALL_PROJECTS_QUERY);

// Extraction unique des catégories pour les filtres
const allFilters = [
  "Tous",
  ...new Set(projects.flatMap((p) => p.categories.map((cat) => cat.title))),
];
---

<Layout
  title="Projets & Réalisations — Arthur Debruille"
  description="Sélection de projets web, architectures front-end et expérimentations interactives : LBQ, SCC France, Cambium, Héliopolis, et développements sur-mesure."
>
  <main>
    <Hero
      title="Projets &"
      subtitle="Expérimentations"
      summary="Découvrez l'ensemble de mes réalisations en développement Front-End, intégrations d'interfaces modulaires, design systems et projets R&D."
      primaryButton={{
        label: "Explorer les projets",
        href: "#posts",
        ariaLabel: "Voir les projets ci-dessous",
      }}
    />

    <PostsSections
      badge="Projets Profesionnel et Perso"
      title="Tous les projets"
      summary="Une sélection de travaux récents alliant architecture modulaire, performance et design soigné."
      filters={allFilters}
    >
      {projects.map((p) => <PostCard post={p} />)}
    </PostsSections>
  </main>
</Layout>
