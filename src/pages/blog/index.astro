---
// src/pages/blog/index.astro
import Layout from "@layout/Layout.astro";
import Hero from "@components/organisms/Hero.astro";
import PostCard from "@components/molecules/Cards/PostCard.astro";
import { sanityClient } from "sanity:client";
import type { Post } from "@@types/index";
import PostsSections from "@components/organisms/PostsSections.astro";
import { ALL_POSTS_QUERY } from "@assets/script/utils/api";

const posts: Post[] = await sanityClient.fetch(ALL_POSTS_QUERY);

const allFilters = [
  "Tous",
  ...new Set(posts.flatMap((p) => p.categories?.map((c) => c.title) ?? [])),
];
---

<Layout
  title="Articles & Notes Techniques — Arthur Debruille"
  description="Pensées, analyses et retours d'expérience sur l'écosystème React, le web moderne et l'architecture logicielle."
>
  <main class="blog-page-container">
    <!-- HERO -->
    <Hero
      title="Écrits techniques &"
      subtitle="Retours d'Expérience."
      summary="Analyses approfondies sur l'écosystème React, les Design Systems, la performance web et l'accessibilité."
      primaryButton={{
        label: "Explorer les articles",
        href: "#posts",
        ariaLabel: "Explorer les articles techniques",
      }}
    />

    <PostsSections
      badge="Veille R&D"
      title="Tous les articles"
      summary="Retours d'expérience, notes d'ingénierie front-end et réflexions sur l'écosystème web moderne."
      filters={allFilters}
    >
      {posts.map((p) => <PostCard post={p} />)}
    </PostsSections>
  </main>
</Layout>
