---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Hero from "@components/organisms/Hero.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="" description="">
  <main>
    <Hero
      title="Le Blog"
      bio="Laboris ut consectetur labore fugiat nulla labore eu Lorem sit sint sit. Minim consequat eu commodo nisi nisi. Nisi in ullamco qui reprehenderit ullamco amet dolore laborum cupidatat consequat. Ipsum commodo adipisicing aliqua nisi anim commodo."
      primaryButton={{
        label: "Explorer les différents articles ↓",
        href: "#projets",
        ariaLabel: "Voir les articles ci-dessous",
      }}
    />

    <section>
      <ul>
        {
          posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>
                {post.data.heroImage && (
                  <Image
                    width={720}
                    height={360}
                    src={post.data.heroImage}
                    alt=""
                  />
                )}
                <h4 class="title">{post.data.title}</h4>
                <p class="date">{post.data.pubDate}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>
