---
// src/pages/blog/[slug].astro
import Layout from "@layout/Layout.astro";
import { PortableTextRenderer } from "@components/Blocks/PortableTextRenderer";
import { sanityClient } from "sanity:client";
import type { Post } from "@@types/index";
import { POST_QUERY, POSTS_SLUGS_QUERY } from "@assets/script/utils/api";
import ArticleHero from "@components/organisms/ArticleHero.astro";

export async function getStaticPaths() {
  const posts = await sanityClient.fetch<{ slug: string }[]>(POSTS_SLUGS_QUERY);
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;

const post: Post = await sanityClient.fetch(POST_QUERY, { slug });


---

<Layout title={`${post.title} — Arthur Debruille`} description={post.summary}>
  <main>
    <ArticleHero post={post} />
    <p class="eyebrow" id="article">// Début de l'article</p>
    <article class="article-body">
      <PortableTextRenderer value={post.body} client:load />
    </article>
  </main>
</Layout>
