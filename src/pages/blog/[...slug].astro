---
// src/pages/blog/[slug].astro
import Layout from "@layout/Layout.astro";
import Hero from "@components/organisms/Hero.astro";
import Footer from "@components/organisms/Footer.astro";
import { PortableTextRenderer } from "@components/Blocks/PortableTextRenderer";
import { sanityClient } from "sanity:client";
import type { Post } from "@@types/index";
import { POST_QUERY, POSTS_SLUGS_QUERY } from "@assets/script/utils/api";
import { urlFor } from "@assets/script/utils/image";

export async function getStaticPaths() {
  const posts = await sanityClient.fetch<{ slug: string }[]>(POSTS_SLUGS_QUERY);
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;

const post: Post = await sanityClient.fetch(POST_QUERY, { slug });

const categoriesString =
  post.categories?.map((c) => c.title).join(" · ") || "Veille & Tech";

const coverUrl = post.coverImage
  ? urlFor(post.coverImage).width(1200).height(675).auto("format").url()
  : null;
---

<Layout title={`${post.title} — Arthur Debruille`} description={post.summary}>
  <main>
    <Hero
      title={post.title}
      summary={post.summary}
      primaryButton={{
        label: "Lire l'article ↓",
        href: "#article",
        ariaLabel: "Défiler vers le contenu de l'article",
      }}
    />
    {
      coverUrl && (
        <div class="article-cover-wrapper">
          <div class="cover-frame">
            <div class="cover-header">
              <div class="dots">
                <span class="red" />
                <span class="orange" />
                <span class="green" />
              </div>
              <span class="cover-format">16:9</span>
            </div>
            <div class="cover-image-container">
              <img
                src={coverUrl}
                alt={post.coverImage?.alt || post.title}
                class="cover-img"
                loading="eager"
              />
            </div>
          </div>
        </div>
      )
    }
    <p class="eyebrow" id="article">// Début de l'article</p>
    <article class="article-body">
      <PortableTextRenderer value={post.body} client:load />
    </article>
  </main>
</Layout>

<style>
  .article-cover-wrapper {
    margin: var(--space-2xl, 2.5rem) 0 var(--space-3xl, 3.5rem) 0;
    position: relative;
  }

  .cover-frame {
    background: #fbf7ee;
    border: 1px solid #2b1810;
    border-radius: 12px;
    overflow: hidden;
    /* Ombre portée franche et chaude (aucun flou terne) */
    box-shadow: 6px 6px 0px #2b1810;
  }

  .cover-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1rem;
    background: #2b1810;
    color: #fbf7ee;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
  }

  .dots {
    display: flex;
    gap: var(--space-2xs);
  }

  .red,
  .green,
  .orange {
    display: block;
    width: 12px;
    height: 12px;
    background-color: #fe5f56;
    border-radius: 8px;
  }

  .orange {
    background-color: #febb30;
  }

  .green {
    background-color: #2bc840;
  }

  .cover-tag {
    color: #fbf7ee;
  }

  .cover-format {
    color: #b85b35;
    font-weight: 600;
  }

  .cover-image-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #140c09;
    overflow: hidden;
  }

  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .cover-frame:hover .cover-img {
    transform: scale(1.015);
  }

  /* Corps de l'article */
  .article-body {
    padding: 1rem 0 4rem 0;
    font-size: 1.05rem;
    color: #2b1810;
  }
</style>
