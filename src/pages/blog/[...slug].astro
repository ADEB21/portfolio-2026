---
// src/pages/blog/[slug].astro
import Layout from "@layout/Layout.astro";
import Hero from "@components/organisms/Hero.astro";
import { PortableTextRenderer } from "@components/Blocks/PortableTextRenderer";
import { sanityClient } from "sanity:client";
import type { Post } from "@@types/index";
import { POST_QUERY, POSTS_SLUGS_QUERY } from "@assets/script/utils/api";
import PostCoverCard from "@components/molecules/Cards/PostCoverCard.astro";

export async function getStaticPaths() {
  const posts = await sanityClient.fetch<{ slug: string }[]>(POSTS_SLUGS_QUERY);
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;

const post: Post = await sanityClient.fetch(POST_QUERY, { slug });

const categoriesString =
  post.categories?.map((c) => c.title).join(" · ") || "Veille & Tech";
---

<Layout title={`${post.title} — Arthur Debruille`} description={post.summary}>
  <main>
    <Hero
      title={post.title}
      summary={post.summary}
      primaryButton={{
        label: "Lire l'article ↓",
        href: "#article",
        ariaLabel: "Défiler vers le contenu de l'article",
      }}
    />
    {
      post.coverImage && <PostCoverCard post={post}/>
    }
    <p class="eyebrow" id="article">// Début de l'article</p>
    <article class="article-body">
      <PortableTextRenderer value={post.body} client:load />
    </article>
  </main>
</Layout>
