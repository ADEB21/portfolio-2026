---
import AppleWindowControls from "@components/atoms/AppleWindowControls.astro";

// src/components/atoms/PageLoader.astro
---

<aside id="page-preloader" class="preloader" aria-hidden="true">
  <div class="shutter shutter-top"></div>
  <div class="shutter shutter-bottom"></div>

  <div class="preloader-panel" id="loader-panel">
    <!-- En-tête console -->
    <div class="preloader-header">
      <AppleWindowControls/>
      <span class="eyebrow">// SYSTEM_BOOT</span>
    </div>

    <!-- Contenu du terminal -->
    <div class="preloader-body">
      <div class="terminal-text">
        <span class="prompt">&gt;</span>
        <span class="command">INITIALIZING_CORE</span>
      </div>

      <!-- Barre de progression -->
      <div class="progress-track">
        <div id="loader-bar" class="progress-bar"></div>
      </div>

      <!-- Métadonnées / Compteur -->
      <div class="preloader-footer">
        <span class="step-label" id="loader-status">LOADING_ASSETS...</span>
        <span class="percentage" id="loader-counter">0%</span>
      </div>
    </div>
  </div>
</aside>

<script>
  import { initLenis } from "@assets/script/utils/lenis";

  function setupLoader() {
    const preloader = document.getElementById("page-preloader");
    const isBooted = sessionStorage.getItem("booted") === "true";
    if (!preloader) return;

    if (isBooted) {
      preloader.remove();
      return;
    }

    preloader.classList.add("is-active");
    initLenis().stop();
    document.body.style.overflow = "hidden";

    const bar = document.getElementById("loader-bar");
    const counter = document.getElementById("loader-counter");
    const status = document.getElementById("loader-status");

    const steps = [
      { progress: 5, text: "DISABLING_SCROLLING..." },
      { progress: 28, text: "PARSING_DESIGN_TOKENS..." },
      { progress: 60, text: "CONNECTING_SANITY_PIPELINE..." },
      { progress: 85, text: "HYDRATING_ISLANDS..." },
      { progress: 90, text: "ENABLING_SCROLLING..." },
      { progress: 100, text: "SITE_READY" },
    ];

    let currentProgress = 0;
    let stepIndex = 0;
    let isPausing = false;

    const interval = setInterval(() => {
      if (isPausing) return;

      if (currentProgress < 100) {
        const increment = Math.floor(Math.random() * 4) + 1;
        currentProgress = Math.min(currentProgress + increment, 100);

        if (bar) bar.style.width = `${currentProgress}%`;
        if (counter) counter.textContent = `${currentProgress}%`;

        if (
          stepIndex < steps.length &&
          currentProgress >= steps[stepIndex].progress
        ) {
          if (status) status.textContent = steps[stepIndex].text;
          stepIndex++;

          if (currentProgress < 100) {
            isPausing = true;
            setTimeout(
              () => {
                isPausing = false;
              },
              Math.floor(Math.random() * 120) + 180,
            );
          }
        }
      } else {
        clearInterval(interval);

        setTimeout(() => {
          sessionStorage.setItem("booted", "true");
          preloader.classList.add("is-exiting");

          // Fonction de nettoyage et réactivation
          const unlockScrollAndCleanup = () => {
            preloader.remove();

            // 2. RÉACTIVATION DU SCROLL
            initLenis().start();
            document.body.style.overflow = "";
          };

          const shutterBottom = preloader.querySelector(".shutter-bottom");
          if (shutterBottom) {
            shutterBottom.addEventListener(
              "transitionend",
              unlockScrollAndCleanup,
              { once: true },
            );
          } else {
            setTimeout(unlockScrollAndCleanup, 600);
          }
        }, 450);
      }
    }, 45);
  }

  document.addEventListener("astro:page-load", setupLoader);
</script>

<style>
  .preloader {
    display: flex;
    position: fixed;
    inset: 0;
    z-index: var(--z-modal, 1000);
    align-items: center;
    justify-content: center;
    padding: var(--space-s, 1rem);
    pointer-events: auto;
  }

  :global(html.portfolio-ready) .preloader {
    display: none !important;
  }

  .shutter {
    position: absolute;
    left: 0;
    right: 0;
    width: 100%;
    height: 50%;
    background: var(--bg-main, #fbf7ee);
    z-index: 1;
    transition: transform 500ms cubic-bezier(0.77, 0, 0.175, 1);
    will-change: transform;
  }

  .shutter-top {
    top: 0;
    transform-origin: top;
  }

  .shutter-bottom {
    bottom: 0;
    transform-origin: bottom;
  }

  .preloader-panel {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 440px;
    background: var(--bg-card-solid, #fffdf9);
    border: 1px solid var(--color-brown, #4c2b24);
    border-radius: var(--radius-sm, 12px);
    box-shadow: 6px 6px 0px var(--color-brown, #4c2b24);
    overflow: hidden;
    transform: scale(1);
    opacity: 1;
    transition:
      transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 200ms ease;
  }

  .preloader-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-xs, 0.75rem) var(--space-s, 1rem);
    background: var(--color-brown, #4c2b24);
    color: var(--color-white, #fbf7ee);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
  }
  
  .preloader-body {
    padding: var(--space-md, 1.5rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-s, 1rem);
  }

  .terminal-text {
    display: flex;
    align-items: center;
    gap: var(--space-2xs, 0.5rem);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-sm, 0.85rem);
    color: var(--text-main, #0f0806);
    font-weight: var(--font-weight-medium, 500);
  }

  .prompt {
    color: var(--color-copper, #b85b35);
    font-weight: bold;
  }

  .command {
    letter-spacing: var(--tracking-wide, 0.05em);
  }

  .progress-track {
    width: 100%;
    height: 6px;
    background: var(--color-brown-soft, rgba(76, 43, 36, 0.08));
    border-radius: var(--radius-full, 9999px);
    overflow: hidden;
    border: 1px solid var(--border-light, rgba(76, 43, 36, 0.12));
  }

  .progress-bar {
    width: 0%;
    height: 100%;
    background: var(--color-copper, #b85b35);
    border-radius: var(--radius-full, 9999px);
    transition: width 100ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .preloader-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
  }

  .step-label {
    color: var(--text-muted, #5a4843);
  }

  .percentage {
    color: var(--color-copper, #b85b35);
    font-weight: var(--font-weight-bold, 700);
  }

  .preloader.is-exiting {
    pointer-events: none;
  }

  .preloader.is-exiting .preloader-panel {
    transform: scale(0.85) translateY(-20px);
    opacity: 0;
  }

  .preloader.is-exiting .shutter-top {
    transform: translateY(-100%);
    transition-delay: 100ms;
  }

  .preloader.is-exiting .shutter-bottom {
    transform: translateY(100%);
    transition-delay: 100ms;
  }
</style>
